<Window x:Class="FluxTranslator.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
        xmlns:tabs="clr-namespace:FluxTranslator.Tabs"
        Title="FluxTranslator"
        Icon="/Resources/icon.ico"
        Width="960" Height="780"
    d:DesignWidth="960" d:DesignHeight="720"
        ResizeMode="CanMinimize"
        MinWidth="640" MinHeight="480"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="SttSubTabBarContainer"
                Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel x:Name="SttSubTabBar" Orientation="Horizontal" Margin="4,0">
                    <RadioButton x:Name="SubTabGeneral"
                                 Content="General"
                                 GroupName="SttTabs"
                                 Tag="General"
                                 Style="{StaticResource SubTabButton}"
                                 IsChecked="True"
                                 Checked="SubTab_Checked"/>
                    <RadioButton x:Name="SubTabAppearance"
                                 Content="Appearance"
                                 GroupName="SttTabs"
                                 Tag="Appearance"
                                 Style="{StaticResource SubTabButton}"
                                 Checked="SubTab_Checked"/>
                    <RadioButton x:Name="SubTabBehavior"
                                 Content="Behavior"
                                 GroupName="SttTabs"
                                 Tag="Behavior"
                                 Style="{StaticResource SubTabButton}"
                                 Checked="SubTab_Checked"/>
                    <RadioButton x:Name="SubTabHotkeys"
                                 Content="Hotkeys"
                                 GroupName="SttTabs"
                                 Tag="Hotkeys"
                                 Style="{StaticResource SubTabButton}"
                                 Checked="SubTab_Checked"/>
                    <RadioButton x:Name="SubTabTts"
                                 Content="Voice TTS"
                                 GroupName="SttTabs"
                                 Tag="Tts"
                                 Style="{StaticResource SubTabButton}"
                                 Checked="SubTab_Checked"/>
                </StackPanel>

                <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="2" Margin="4,0" IsHitTestVisible="False">
                    <Border x:Name="TabIndicator"
                            Height="2"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="1,1,0,0"/>
                </Canvas>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <tabs:GeneralTab    x:Name="TabGeneral"    Visibility="Visible"/>
            <tabs:AppearanceTab x:Name="TabAppearance" Visibility="Collapsed"/>
            <tabs:BehaviorTab   x:Name="TabBehavior"   Visibility="Collapsed"/>
            <tabs:HotkeysTab    x:Name="TabHotkeys"    Visibility="Collapsed"/>
            <tabs:TtsTab        x:Name="TabTts"        Visibility="Collapsed"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="18,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TbStatus"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Column="1"
                           x:Name="TbVersion"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
