<Window x:Class="FluxTranslator.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FluxOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        ShowActivated="False"
        Focusable="False">

    <Border x:Name="RootBorder"
            CornerRadius="10"
            Padding="10">
        <Border.Background>
            <SolidColorBrush x:Name="BgBrush" Color="#CC000000"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2"
                              Color="Black" Opacity="0.5"/>
        </Border.Effect>

        <TextBlock x:Name="DisplayText"
                   Foreground="White"
                   FontSize="18"
                   FontFamily="Segoe UI"
                   TextWrapping="Wrap"
                   MaxWidth="780"
                   MinWidth="230"
                   Text=""/>
    </Border>
</Window>
