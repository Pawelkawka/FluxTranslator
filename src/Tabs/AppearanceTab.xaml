<UserControl x:Class="FluxTranslator.Tabs.AppearanceTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="720"
             xmlns:ctrl="clr-namespace:FluxTranslator.Controls">
    <Grid PreviewMouseDown="Appearance_PreviewMouseDown"
          PreviewKeyDown="Appearance_PreviewKeyDown">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,16,28,24">

            <TextBlock Style="{StaticResource H1}" Text="Appearance"/>

            <TextBlock Style="{StaticResource H2}" Text="Overlay Position"/>
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Position on screen" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbPosition" Grid.Column="1"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="CbPosition_SelectionChanged"/>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource H2}" Text="Monitor"/>
            <Border Style="{StaticResource SettingCard}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Display on monitor" Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="13" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CbMonitor" Grid.Column="1"
                              Style="{StaticResource ModernComboBox}"
                              SelectionChanged="CbMonitor_SelectionChanged"/>
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource H2}" Text="Text"/>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Font Family" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <ComboBox x:Name="CbFont" Grid.Column="1" Style="{StaticResource ModernComboBox}"
                                  SelectionChanged="CbFont_SelectionChanged"/>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Font Size" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SlFontSize" Grid.Column="1" Minimum="8" Maximum="72" TickFrequency="1"
                                IsSnapToTickEnabled="True" Style="{StaticResource ModernSlider}"
                                ValueChanged="SlFontSize_ValueChanged"/>
                        <TextBlock x:Name="LblFontSize" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="6,0,0,0"/>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Bold Text" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <CheckBox x:Name="ChkBold" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" Checked="ChkBold_Changed" Unchecked="ChkBold_Changed"/>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Text Color" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Border x:Name="PrvText" Grid.Column="1" Width="26" Height="26" CornerRadius="4"
                                Margin="4,0,0,0" Cursor="Hand" HorizontalAlignment="Right"
                                MouseLeftButtonDown="PrvText_Click"
                                Background="White"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource H2}" Text="Style"/>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Background Color" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Border x:Name="PrvBg" Grid.Column="1" Width="26" Height="26" CornerRadius="4"
                                Margin="4,0,0,0" Cursor="Hand" HorizontalAlignment="Right"
                                MouseLeftButtonDown="PrvBg_Click"
                                Background="Black"/>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Background Opacity %" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SlBgOpacity" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1"
                                IsSnapToTickEnabled="True" Style="{StaticResource ModernSlider}"
                                ValueChanged="SlBgOpacity_ValueChanged"/>
                        <TextBlock x:Name="LblBgOpacity" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="6,0,0,0"/>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Padding (px)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SlPadding" Grid.Column="1" Minimum="0" Maximum="60" TickFrequency="1"
                                IsSnapToTickEnabled="True" Style="{StaticResource ModernSlider}"
                                ValueChanged="SlPadding_ValueChanged"/>
                        <TextBlock x:Name="LblPadding" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="6,0,0,0"/>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Corner Radius" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SlCorner" Grid.Column="1" Minimum="0" Maximum="40" TickFrequency="1"
                                IsSnapToTickEnabled="True" Style="{StaticResource ModernSlider}"
                                ValueChanged="SlCorner_ValueChanged"/>
                        <TextBlock x:Name="LblCorner" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="6,0,0,0"/>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Border Width (px)" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Slider x:Name="SlBorderWidth" Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="1"
                                IsSnapToTickEnabled="True" Style="{StaticResource ModernSlider}"
                                ValueChanged="SlBorderWidth_ValueChanged"/>
                        <TextBlock x:Name="LblBorderWidth" Grid.Column="2" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="6,0,0,0"/>
                    </Grid>
                    <Separator Background="{StaticResource BorderBrush}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Border Color" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                        <Border x:Name="PrvBorder" Grid.Column="1" Width="26" Height="26" CornerRadius="4"
                                Margin="4,0,0,0" Cursor="Hand" HorizontalAlignment="Right"
                                MouseLeftButtonDown="PrvBorder_Click"
                                Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource H2}" Text="Preview"/>
            <Border Style="{StaticResource SettingCard}" Padding="16">
                <Grid Background="#FF111111" MinHeight="90">
                    <Border x:Name="PreviewOverlay"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewText"
                                   Text="Translated text appears here"
                                   TextWrapping="Wrap"
                                   MaxWidth="400"/>
                    </Border>
                </Grid>
            </Border>

            <Button x:Name="BtnReset"
                    Content="Reset to Defaults"
                    Style="{StaticResource ModernButton}"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0"
                    Click="BtnReset_Click"/>

        </StackPanel>
    </ScrollViewer>

    <Popup x:Name="ColorPickerPopup"
           StaysOpen="True"
           AllowsTransparency="True"
           PopupAnimation="Fade">
        <ctrl:ColorPickerControl x:Name="Picker"/>
    </Popup>

    </Grid>
</UserControl>
