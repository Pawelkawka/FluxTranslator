<UserControl x:Class="FluxTranslator.Tabs.BehaviorTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="960" d:DesignHeight="720">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,16,28,24">

            <TextBlock Style="{StaticResource H1}" Text="Behavior"/>

            <TextBlock Style="{StaticResource H2}" Text="Overlay"/>
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Overlay Display Time"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"/>
                            <TextBlock Text="How long the translation overlay stays on screen"
                                       Style="{StaticResource SubText}"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Slider x:Name="SlDisplayTime"
                                Grid.Column="1"
                                Minimum="2" Maximum="60" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Style="{StaticResource ModernSlider}"
                                VerticalAlignment="Center"
                                ValueChanged="SlDisplayTime_ValueChanged"/>

                        <TextBlock x:Name="LblDisplayTime"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="6,0,0,0"/>
                    </Grid>

                    <Separator Background="{StaticResource BorderBrush}" Margin="0,14,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Max Recording Time"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="13"/>
                            <TextBlock Text="Safety limit for one recording session before STT stops automatically"
                                       Style="{StaticResource SubText}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Slider x:Name="SlMaxRecordingSeconds"
                                Grid.Column="1"
                                Minimum="1" Maximum="120" TickFrequency="1"
                                IsSnapToTickEnabled="True"
                                Style="{StaticResource ModernSlider}"
                                VerticalAlignment="Center"
                                ValueChanged="SlMaxRecordingSeconds_ValueChanged"/>

                        <TextBlock x:Name="LblMaxRecordingSeconds"
                                   Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"
                                   Margin="6,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource H2}" Text="Speech Capture"/>
            <TextBlock Text="Manual mode requires pressing the translate hotkey again to finish recording. Auto mode stops after silence."
                       Style="{StaticResource SubText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="RbManualMode"
                             Grid.Column="0"
                             GroupName="RecordingModeGroup"
                             Style="{StaticResource EngineCard}"
                             Checked="RecordingMode_Checked">
                    <StackPanel>
                        <TextBlock Text="Manual mode"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Press the hotkey again to stop recording"
                                   Style="{StaticResource SubText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>

                <RadioButton x:Name="RbAutoMode"
                             Grid.Column="2"
                             GroupName="RecordingModeGroup"
                             Style="{StaticResource EngineCard}"
                             Checked="RecordingMode_Checked">
                    <StackPanel>
                        <TextBlock Text="Auto mode"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Recording stops automatically after a period of silence"
                                   Style="{StaticResource SubText}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </RadioButton>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
